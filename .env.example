# ── Local Development ──────────────────────────────────────────────────────────
# SQLite (dev only — not suitable for Vercel serverless)
DATABASE_URL="file:./prisma/dev.db"

# ── Production (Vercel) ────────────────────────────────────────────────────────
# Option 1: Turso (libsql) — works with the existing @prisma/adapter-libsql
# DATABASE_URL="libsql://your-db.turso.io?authToken=your-token"

# Option 2: Supabase / Neon PostgreSQL
# Change adapter in src/lib/db/prisma.ts to @prisma/adapter-pg
# DATABASE_URL="postgres://user:pass@host:5432/dbname"

# ── AI ─────────────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
# Uses llama-3.1-8b-instant model (free tier)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
